@page
@model StyleSphere.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Users Management</h1>
        <a asp-page="Create" class="btn btn-primary">Create New User</a>
    </div>

    @if (Model.Users != null && Model.Users.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserID</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@(user.Phone ?? "N/A")</td>
                            <td>
                                <span class="badge bg-@(user.Role == "Admin" ? "danger" : "info")">@user.Role</span>
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@user.UserID" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-page="Delete" asp-route-id="@user.UserID" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No users found. <a asp-page="Create">Create the first user</a>
        </div>
    }
</div>

