@page
@model StyleSphere.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Products Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Products Management</h1>
        <a asp-page="Create" class="btn btn-primary">Create New Product</a>
    </div>

    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>@product.ProductID</td>
                            <td>
                                <img src="@product.Image" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                            </td>
                            <td>@product.Name</td>
                            <td>@(product.Category?.Name ?? "N/A")</td>
                            <td>$@product.Price.ToString("F2")</td>
                            <td>
                                <span class="badge bg-@(product.Stock > 0 ? "success" : "danger")">@product.Stock</span>
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@product.ProductID" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-page="Delete" asp-route-id="@product.ProductID" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No products found. <a asp-page="Create">Create the first product</a>
        </div>
    }
</div>

