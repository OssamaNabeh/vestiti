@page
@model StyleSphere.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Categories Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Categories Management</h1>
        <a asp-page="Create" class="btn btn-primary">Create New Category</a>
    </div>

    @if (Model.Categories != null && Model.Categories.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Products Count</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td>@category.CategoryID</td>
                            <td>@category.Name</td>
                            <td>@(category.Description ?? "N/A")</td>
                            <td>@(category.Products?.Count ?? 0)</td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@category.CategoryID" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-page="Delete" asp-route-id="@category.CategoryID" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No categories found. <a asp-page="Create">Create the first category</a>
        </div>
    }
</div>

