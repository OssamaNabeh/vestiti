@page
@model StyleSphere.Pages.loginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_CustomerLayout";
}

<div class="auth-wrap">
    <div class="auth-visual"><img src="@StyleSphere.Data.Catalog.Img("1539109136881-3be0616acf4b", 1200)" alt="" /><blockquote>Style is a way to say who you are without having to speak.</blockquote></div>
    <div class="auth-container">
        <h1>Welcome back</h1><p class="sub">Sign in to your Vestiti account.</p>
        <form method="post" id="login-form">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            
            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" class="form-control" placeholder="Enter your email" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" required />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn">Sign in</button>
        </form>
        <div class="auth-switch">
            New to Vestiti? <a asp-page="/Register">Create an account</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
