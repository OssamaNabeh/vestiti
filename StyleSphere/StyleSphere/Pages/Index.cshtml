@page
@using System.Globalization
@using StyleSphere.Data
@model StyleSphere.Pages.IndexModel
@{
    ViewData["Title"] = "Considered fashion";
    Layout = "_CustomerLayout";
    var hero = Model.HeroProduct!;
    var inv = CultureInfo.InvariantCulture;
}

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">Autumn / Winter Collection</span>
        <h1>Dress for the<br>life you <em>actually</em> live.</h1>
        <p class="lead">Considered pieces in honest fabrics — cut in Milan, made to be worn for years, not weeks.</p>
        <div class="hero-cta">
            <a asp-page="/Products" class="btn">Shop the collection</a>
            <a asp-page="/Products" asp-route-sort="newest" class="btn btn-outline">New arrivals</a>
        </div>
        <div class="hero-meta">
            <div><b>28</b><span>New pieces</span></div>
            <div><b>4.8★</b><span>Avg. rating</span></div>
            <div><b>30 days</b><span>Free returns</span></div>
        </div>
    </div>
    <div class="hero-media">
        <img src="@Catalog.Img("1595777457583-95e059d581b8", 1400)" alt="Model wearing a flowing red dress in a garden" fetchpriority="high" />
        <a class="hero-tag" asp-page="/details" asp-route-id="@hero.Id">
            <img src="@Catalog.Img(hero.Images[0], 160)" alt="@hero.Name" />
            <span><small>Featured</small><b>@hero.Name</b><small>$@hero.Price.ToString("0", inv)</small></span>
            <i class="fa-solid fa-arrow-right" style="margin-left:auto"></i>
        </a>
    </div>
</section>

<div class="trust">
    <div class="container">
        <div class="trust-item"><i class="fa-solid fa-truck-fast"></i><div><b>Free shipping</b><span>On orders over $150</span></div></div>
        <div class="trust-item"><i class="fa-solid fa-rotate-left"></i><div><b>30-day returns</b><span>Free and easy</span></div></div>
        <div class="trust-item"><i class="fa-solid fa-shield-halved"></i><div><b>Secure checkout</b><span>Encrypted payments</span></div></div>
        <div class="trust-item"><i class="fa-regular fa-gem"></i><div><b>Built to last</b><span>Premium materials</span></div></div>
    </div>
</div>

<!-- Categories -->
<section class="section">
    <div class="container">
        <div class="section-head reveal">
            <div><span class="eyebrow">Shop by category</span><h2>Find your wardrobe</h2></div>
            <a class="link-arrow" asp-page="/Products">View all <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="cat-grid">
            @foreach (var c in Catalog.Categories)
            {
                <a class="cat-card reveal" href="/Products?category=@c.Name">
                    <img src="@Catalog.Img(c.Cover, 700)" alt="@c.Name" loading="lazy" />
                    <div class="cat-info">
                        <div><small>@Catalog.All.Count(p => p.Category == c.Name) pieces</small><h3>@c.Name</h3></div>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- Trending -->
<section class="section alt">
    <div class="container">
        <div class="section-head reveal">
            <div><span class="eyebrow">Right now</span><h2>Trending</h2></div>
            <div class="tabs" role="tablist" id="trend-tabs">
                <button type="button" class="tab active" data-filter="all">All</button>
                @foreach (var c in Catalog.Categories)
                {
                    <button type="button" class="tab" data-filter="@c.Name">@c.Name</button>
                }
            </div>
        </div>
        <div class="product-grid" id="trend-grid">
            @foreach (var p in Model.Trending)
            {
                <div class="reveal" data-cat="@p.Category"><partial name="_ProductCard" model="p" /></div>
            }
        </div>
        <div class="empty" id="trend-empty" hidden>
            <i class="fa-regular fa-folder-open"></i>
            <h3>Nothing trending here yet</h3>
            <p>Check back soon, or explore every category.</p>
        </div>
    </div>
</section>

<!-- Best sellers -->
<section class="section">
    <div class="container">
        <div class="section-head reveal">
            <div><span class="eyebrow">Loved by customers</span><h2>Best sellers</h2></div>
            <div class="scroller-nav">
                <button type="button" class="icon-btn" id="bs-prev" aria-label="Previous best sellers"><i class="fa-solid fa-arrow-left"></i></button>
                <button type="button" class="icon-btn" id="bs-next" aria-label="Next best sellers"><i class="fa-solid fa-arrow-right"></i></button>
            </div>
        </div>
        <div class="scroller" id="bs-scroller">
            @foreach (var p in Model.BestSellers)
            {
                <div><partial name="_ProductCard" model="p" /></div>
            }
        </div>
    </div>
</section>

<!-- Promotions -->
<section class="section tight" style="padding-top:0">
    <div class="container promo-grid">
        <a class="promo reveal" href="/Products?sale=1">
            <img src="@Catalog.Img("1445205170230-053b83016050", 1400)" alt="Outerwear & tailoring sale" loading="lazy" />
            <div class="promo-body">
                <span class="eyebrow" style="color:#fff;opacity:.85">Seasonal edit</span>
                <h3>Up to 25% off outerwear &amp; tailoring</h3>
                <p>Coats, suits and leather — priced down for a limited time.</p>
                <span class="btn btn-light">Shop the sale</span>
            </div>
        </a>
        <div class="promo solid reveal">
            <div class="promo-body" style="max-width:none">
                <span class="eyebrow" style="color:#bcd0c4">Welcome offer</span>
                <div class="big">10%</div>
                <p>off your first order with code <b>VESTITI10</b>.</p>
                <span class="code">VESTITI10</span>
                <button type="button" class="btn btn-light" data-claim-code="VESTITI10" style="margin-top:6px">Apply 10% code</button>
            </div>
        </div>
    </div>
</section>

<!-- New arrivals -->
<section class="section alt">
    <div class="container">
        <div class="section-head reveal">
            <div><span class="eyebrow">Just landed</span><h2>New arrivals</h2></div>
            <a class="link-arrow" asp-page="/Products" asp-route-sort="newest">Shop new <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="product-grid">
            @foreach (var p in Model.NewArrivals)
            {
                <div class="reveal"><partial name="_ProductCard" model="p" /></div>
            }
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="section">
    <div class="container">
        <div class="section-head reveal">
            <div><span class="eyebrow">Reviews</span><h2>Worn, loved, repeated</h2></div>
            <div class="rating" style="font-size:14px"><span class="stars" style="font-size:16px">★★★★★</span> 4.8 from 3,200+ reviews</div>
        </div>
        <div class="t-grid">
            <figure class="t-card reveal" style="margin:0">
                <span class="stars" style="font-size:16px">★★★★★</span>
                <blockquote>“The camel coat is the best purchase I’ve made in years. The fabric feels expensive and the fit is perfect.”</blockquote>
                <figcaption class="t-person"><img src="@Catalog.Img("1483985988355-763728e1935b", 160)" alt="" style="object-position:top" /><span><b>Giulia R.</b><small>Verified buyer · Milan</small></span></figcaption>
            </figure>
            <figure class="t-card reveal" style="margin:0">
                <span class="stars" style="font-size:16px">★★★★★</span>
                <blockquote>“Delivery was fast, packaging was beautiful, and the leather jacket looks even better in person.”</blockquote>
                <figcaption class="t-person"><img src="@Catalog.Img("1614252369475-531eba835eb1", 160)" alt="" style="object-position:top" /><span><b>Marco D.</b><small>Verified buyer · Rome</small></span></figcaption>
            </figure>
            <figure class="t-card reveal" style="margin:0">
                <span class="stars" style="font-size:16px">★★★★★</span>
                <blockquote>“Finally a store where sizing is accurate. I’ve ordered three times and every piece has fit first try.”</blockquote>
                <figcaption class="t-person"><img src="@Catalog.Img("1581044777550-4cfa60707c03", 160)" alt="" style="object-position:top" /><span><b>Yuki T.</b><small>Verified buyer · London</small></span></figcaption>
            </figure>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const tabs = document.querySelectorAll('#trend-tabs .tab');
            const items = document.querySelectorAll('#trend-grid > [data-cat]');
            tabs.forEach(t => t.addEventListener('click', () => {
                tabs.forEach(x => x.classList.toggle('active', x === t));
                let shown = 0;
                items.forEach(i => {
                    const on = t.dataset.filter === 'all' || i.dataset.cat === t.dataset.filter;
                    i.hidden = !on;
                    if (on) { i.classList.add('in'); shown++; }
                });
                document.getElementById('trend-empty').hidden = shown > 0;
            }));

            const sc = document.getElementById('bs-scroller');
            const step = () => Math.max(260, sc.clientWidth * 0.78);
            document.getElementById('bs-prev').addEventListener('click', () => {
                if (sc.scrollLeft <= 8) sc.scrollTo({ left: sc.scrollWidth, behavior: 'smooth' });
                else sc.scrollBy({ left: -step(), behavior: 'smooth' });
            });
            document.getElementById('bs-next').addEventListener('click', () => {
                if (sc.scrollLeft + sc.clientWidth >= sc.scrollWidth - 8) sc.scrollTo({ left: 0, behavior: 'smooth' });
                else sc.scrollBy({ left: step(), behavior: 'smooth' });
            });
        })();
    </script>
}
